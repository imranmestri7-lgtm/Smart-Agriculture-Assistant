# =============================================================================
# AgriSmart Root Environment Template
# Copy this file to `backend/.env` for backend execution.
# NEVER commit `.env` containing real credentials to Git.
# =============================================================================

# Database Configuration (MySQL 8.0+)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_secure_database_password_here
DB_NAME=smart_agriculture
DB_PORT=3306

# Twilio SMS Verification Service (For phone OTP authentication)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid_here

# WeatherAPI Service (api.weatherapi.com)
WEATHER_API_KEY=your_weatherapi_key_here

# JWT & Flask Application Security
JWT_SECRET_KEY=your_64_character_cryptographically_secure_jwt_secret_key_here
SECRET_KEY=your_flask_session_secret_key_here

# Server & Deployment Configuration
FLASK_ENV=production
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
PORT=5000

# Security Controls
CORS_ALLOWED_ORIGINS=*
MAX_CONTENT_LENGTH=16777216
DISABLE_RATE_LIMITER=false
