# =========================================================
# AgriSmart Backend Environment Configuration (Template)
# Copy this file to `backend/.env` and fill in your actual credentials.
# DO NOT commit `backend/.env` or any file containing real secrets to Git.
# =========================================================

# Database Configuration (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password_here
DB_NAME=agrismart
DB_PORT=3306

# Twilio SMS Verification Service (For OTP login)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid_here

# WeatherAPI Service (api.weatherapi.com)
WEATHER_API_KEY=your_weatherapi_key_here

# Flask Configuration
FLASK_ENV=development
FLASK_PORT=5000
